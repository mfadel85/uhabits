{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "dynamodb:GetItem",
                "dynamodb:Scan",
                "dynamodb:Query",
                "dynamodb:BatchGetItem"
            ],
            "Resource": [
                "arn:aws:dynamodb:eu-central-1:*:table/uHabits-Analytics-prod",
                "arn:aws:dynamodb:eu-central-1:*:table/uHabits-Analytics-prod/index/*"
            ]
        }
    ]
}
